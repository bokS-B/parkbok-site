{
  "name": "parkbok",
  "main": "tools/cloudflare-worker.mjs",
  "compatibility_date": "2026-11-09",
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "directory": "_build/pages",
    "binding": "ASSETS",
    "html_handling": "none",
    "not_found_handling": "404-page",
    "run_worker_first": true
  }
}
